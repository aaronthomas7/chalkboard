# PayPal sandbox REST app: Developer Dashboard → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A second sandbox *business* account that plays the shop in `npm run check:payee`.
# It must NOT be the account that owns the app above, or the check proves nothing.
SHOP_PAYPAL_EMAIL=

# Claude API key, used to read menu photos and to run each shop's ordering assistant
ANTHROPIC_API_KEY=

# Optional: create the sample shop "Rosa's Bakery" at startup, paid to this sandbox business account.
SAMPLE_SHOP_PAYPAL_EMAIL=
# Key for the sample shop's owner dashboard (/s/rosas-bakery/manage?key=...). Defaults to "demo".
SAMPLE_SHOP_OWNER_KEY=

PORT=4100
# Public base URL that PayPal sends buyers back to. Not needed on Render, which provides it.
PUBLIC_URL=
